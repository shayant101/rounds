# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
# Optional. First model your account can use is tried if this is blank.
ROUNDS_MODEL=
PORT=3000
# Optional: voice. AssemblyAI streaming (English + Spanish, medical mode). Leave blank to use the browser's speech recognition.
ASSEMBLYAI_API_KEY=
# Optional: model for voice understanding (defaults to claude-haiku-5-5, then fallbacks).
ROUNDS_VOICE_MODEL=
